{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".firebaseignore",
      "**/.*",
      "**/node_modules/**",
      "cook/**",
      "interview/**",
      "leecode/**",
      "outputs/**",
      "scripts/**",
      "*.c",
      "*.cpp",
      "*.rar",
      "*.log"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
